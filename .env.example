# Porto pipeline configuration (copy to .env). All optional -- sensible defaults work with zero setup.

# DuckDB warehouse path (relative to project root)
# PIPELINE_DB_PATH=data/demo.duckdb

# Synthetic data generation
# PIPELINE_SEED=42
# PIPELINE_CUSTOMERS=400
# PIPELINE_DAYS=14

# Optional GSheet export (off by default -- CSV export always runs regardless)
# PIPELINE_SHEETS_ENABLED=0
# PIPELINE_SHEETS_CREDENTIALS_FILE=credentials.json

# Optional email alert on pipeline failure (Gmail SMTP + app password)
# PIPELINE_ALERT_EMAIL=
# PIPELINE_ALERT_APP_PASSWORD=
